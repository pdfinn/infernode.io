---
import { useTranslations, type Lang } from '../i18n/utils';
import BoardArt from './BoardArt.astro';
import Laptop from './art/Laptop.astro';
import Jetson from './art/Jetson.astro';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang).distributedArch;

const pis = [
  { board: 'pi3' as const, name: 'Raspberry Pi 3B+', y: 12 },
  { board: 'pi4' as const, name: 'Raspberry Pi 4', y: 140 },
  { board: 'pi5' as const, name: 'Raspberry Pi 5', y: 268 },
];
const fan = pis.map((p) => `M412 180 C530 180 530 ${p.y + 51} 640 ${p.y + 51}`);

// The module being edited, as the laptop's Xenith shows it.
const code: [string, boolean][] = [
  ['implement Anchorwatch;', false],
  ['', false],
  ['RADIUS: con 40.0;    # metres; was 30', true],
  ['', false],
  ['watch(drop: Pos)', false],
  ['{', false],
  ['    for(;;){', false],
  ['        p := readpos("/mnt/gps/position");', false],
  ['        if(dist(drop, p) > RADIUS)', false],
  ['            alarm("anchor dragging");', false],
  ['        sys->sleep(5000);', false],
  ['    }', false],
  ['}', false],
];

const drawCable = 'M288 128 C400 128 430 118 540 118';
const inputCable = 'M540 206 C430 206 400 196 288 196';
---

<section id="distributed" class="px-6 py-24 lg:py-32">
  <div class="mx-auto max-w-5xl">
    <div class="mb-16 text-center">
      <p class="mb-4 text-sm font-medium tracking-widest uppercase text-accent">
        {t.eyebrow}
      </p>
      <h2 class="mb-6 text-3xl font-bold tracking-tight sm:text-4xl">
        {t.title}
      </h2>
      <p class="mx-auto max-w-2xl text-lg text-text-muted" set:html={t.intro} />
    </div>

    <!-- Scene 1: one build, every board -->
    <div class="mb-20">
      <h3 class="mb-8 text-center text-xl font-semibold">
        {t.hotloadTitle}
      </h3>

      <figure class="mx-auto max-w-4xl">
        <svg viewBox="0 0 960 380" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-label={t.hotloadFigLabel}>
          {fan.map((d, i) => (
            <>
              <path d={d} class="stroke-accent/40" stroke-width="2.5" stroke-linecap="round" />
              <g>
                <rect x="-6" y="-7" width="12" height="14" rx="1.5" class="fill-accent" />
                <path d="M-3 -2 h6 M-3 1 h6 M-3 4 h4" class="stroke-bg" stroke-width="1" />
                <animateMotion dur={`${2.2 + i * 0.35}s`} repeatCount="indefinite" path={d} />
              </g>
            </>
          ))}
          <rect x="462" y="168" width="136" height="26" rx="13" class="fill-bg stroke-accent/60" />
          <text x="530" y="186" text-anchor="middle" class="fill-accent" font-size="13" font-family="var(--font-family-mono)">anchorwatch.dis</text>

          <Laptop x={30} y={50} width={400} class="text-node-laptop">
            <rect width="372" height="234" class="fill-bg" />
            <rect width="372" height="15" class="fill-bg-surface-hover" />
            <text x="6" y="10.5" class="fill-text-muted" font-size="7.5" font-family="var(--font-family-mono)">/usr/you/anchorwatch.b  Del Snarf Undo Put</text>
            <rect x="4" y="47" width="364" height="13.5" rx="2" class="fill-accent/15" />
            <g font-size="9.5" font-family="var(--font-family-mono)" class="fill-text">
              {code.map(([line, hot], i) => (
                <text x="8" y={30 + i * 13.5} class={hot ? 'fill-accent' : undefined} xml:space="preserve">{line}</text>
              ))}
            </g>
            <rect y="208" width="372" height="26" class="fill-bg-surface" />
            <text x="8" y="225" font-size="9.5" font-family="var(--font-family-mono)" xml:space="preserve"><tspan class="fill-accent">; </tspan><tspan class="fill-text">mk install</tspan></text>
          </Laptop>

          {pis.map((p) => (
            <>
              <BoardArt board={p.board} label="" x={640} y={p.y} width={150} class="text-node-rpi" />
              <text x="806" y={p.y + 44} class="fill-text" font-size="15" font-weight="600" font-family="var(--font-family-sans)">{p.name}</text>
              <circle cx="812" cy={p.y + 63} r="4" class="fill-node-jetson">
                <animate attributeName="opacity" values="1;0.35;1" dur="2s" repeatCount="indefinite" />
              </circle>
              <text x="822" y={p.y + 67} class="fill-text-muted" font-size="12" font-family="var(--font-family-mono)">{t.hotloadRunning}</text>
            </>
          ))}
        </svg>
      </figure>

      <div class="mx-auto mt-6 max-w-2xl overflow-hidden rounded-xl border border-border bg-bg-surface font-mono text-sm">
        <div class="flex items-center gap-2 border-b border-border px-4 py-2">
          <div class="h-2.5 w-2.5 rounded-full bg-node-rpi/60"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-node-llm/60"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-node-jetson/60"></div>
          <span class="ml-2 text-xs text-text-muted">{t.hotloadTermLabel}</span>
        </div>
        <div class="space-y-1 overflow-x-auto p-4">
          <div class="whitespace-pre text-text-muted">{t.hotloadTermLaptop}</div>
          <div class="whitespace-pre"><span class="text-accent">;</span><span class="text-text"> listen 'tcp!*!styx' {'{'}export /dis{'}'} &amp;</span></div>
          <div class="whitespace-pre pt-2 text-text-muted">{t.hotloadTermPi}</div>
          <div class="whitespace-pre"><span class="text-accent">;</span><span class="text-text"> mount 'tcp!laptop!styx' /n/laptop</span></div>
          <div class="whitespace-pre"><span class="text-accent">;</span><span class="text-text"> bind /n/laptop/anchorwatch.dis /dis/anchorwatch.dis</span></div>
          <div class="whitespace-pre"><span class="text-accent">;</span><span class="text-text"> anchorwatch &amp;</span></div>
          <div class="whitespace-pre pt-2 text-text-muted">{t.hotloadTermNote1}</div>
          <div class="whitespace-pre text-text-muted">{t.hotloadTermNote2}</div>
        </div>
      </div>

      <div class="mx-auto mt-6 grid max-w-2xl gap-4 sm:grid-cols-2">
        <div class="rounded-lg border border-border/50 bg-bg-surface/50 px-5 py-4">
          <p class="mb-1 text-xs font-medium text-accent">{t.hotloadDevsLabel}</p>
          <p class="text-sm leading-relaxed text-text-muted" set:html={t.hotloadDevsBody} />
        </div>
        <div class="rounded-lg border border-border/50 bg-bg-surface/50 px-5 py-4">
          <p class="mb-1 text-xs font-medium text-accent">{t.hotloadPracticeLabel}</p>
          <p class="text-sm leading-relaxed text-text-muted" set:html={t.hotloadPracticeBody} />
        </div>
      </div>
    </div>

    <div class="mx-auto mb-20 h-px w-32 bg-border"></div>

    <!-- Scene 2: the Jetson has the GPU, the laptop has the screen -->
    <div>
      <h3 class="mb-8 text-center text-xl font-semibold">
        {t.remoteTitle}
      </h3>

      <figure class="mx-auto max-w-4xl">
        <svg viewBox="0 0 960 330" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" role="img" aria-label={t.remoteFigLabel}>
          <path d={drawCable} class="stroke-accent/50" stroke-width="2.5" stroke-linecap="round" />
          <path d={inputCable} class="stroke-node-laptop/50" stroke-width="2.5" stroke-linecap="round" />
          <circle r="5" class="fill-accent"><animateMotion dur="1.6s" repeatCount="indefinite" path={drawCable} /></circle>
          <circle r="5" class="fill-accent"><animateMotion dur="1.6s" begin="0.8s" repeatCount="indefinite" path={drawCable} /></circle>
          <circle r="5" class="fill-node-laptop"><animateMotion dur="2.2s" repeatCount="indefinite" path={inputCable} /></circle>
          <g font-size="13" font-family="var(--font-family-mono)" text-anchor="middle">
            <text x="414" y="104" class="fill-accent">/dev/draw</text>
            <text x="414" y="232" class="fill-node-laptop">/dev/pointer  /dev/keyboard</text>
          </g>

          <Jetson x={60} y={70} width={230} class="text-node-jetson" />
          <line x1="36" y1="264" x2="314" y2="264" class="stroke-border" stroke-width="3" stroke-linecap="round" />
          <text x="175" y="294" text-anchor="middle" class="fill-text-muted" font-size="14" font-family="var(--font-family-sans)">{t.remoteNoScreen}</text>

          <Laptop x={520} y={24} width={420} class="text-node-laptop">
            <rect width="372" height="234" fill="#0d0d14" />
            <rect x="20" y="16" width="332" height="200" rx="3" class="fill-bg stroke-node-jetson/70" />
            <rect x="20" y="16" width="332" height="15" rx="3" class="fill-node-jetson/20" />
            <text x="28" y="26.5" class="fill-node-jetson" font-size="8" font-family="var(--font-family-mono)">jetson · wm/wm</text>
            <rect x="30" y="40" width="312" height="166" rx="2" class="fill-bg-surface stroke-border" />
            <g font-size="10.5" font-family="var(--font-family-mono)" xml:space="preserve">
              <text x="42" y="60"><tspan class="fill-accent">; </tspan><tspan class="fill-text">cat /dev/sysname</tspan></text>
              <text x="42" y="76" class="fill-text-muted">jetson</text>
              <text x="42" y="92"><tspan class="fill-accent">; </tspan><tspan class="fill-text">date</tspan></text>
              <text x="42" y="108" class="fill-text-muted">Fri Nov 06 14:32:05 GMT 2026</text>
              <text x="42" y="124"><tspan class="fill-accent">; </tspan></text>
              <rect x="56" y="115" width="6.5" height="12" class="fill-text">
                <animate attributeName="opacity" values="1;0;1" dur="1.1s" repeatCount="indefinite" />
              </rect>
            </g>
            <path d="M262 150 l0 16 l4 -4 l3 7 l3 -1.5 l-3 -7 l5.5 0 z" class="fill-text stroke-bg" stroke-width="1" />
          </Laptop>
        </svg>
      </figure>

      <div class="mx-auto mt-6 max-w-2xl overflow-hidden rounded-xl border border-border bg-bg-surface font-mono text-sm">
        <div class="flex items-center gap-2 border-b border-border px-4 py-2">
          <div class="h-2.5 w-2.5 rounded-full bg-node-rpi/60"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-node-llm/60"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-node-jetson/60"></div>
          <span class="ml-2 text-xs text-text-muted">{t.remoteTermLabel}</span>
        </div>
        <div class="space-y-1 overflow-x-auto p-4">
          <div class="whitespace-pre"><span class="text-accent">;</span><span class="text-text"> cpu tcp!jetson wm/wm wm/sh &amp;</span></div>
          <div class="whitespace-pre text-text-muted">{t.remoteTermNote1}</div>
          <div class="whitespace-pre text-text-muted">{t.remoteTermNote2}</div>
        </div>
      </div>

      <div class="mx-auto mt-6 grid max-w-2xl gap-4 sm:grid-cols-2">
        <div class="rounded-lg border border-border/50 bg-bg-surface/50 px-5 py-4">
          <p class="mb-1 text-xs font-medium text-accent">{t.remoteDevsLabel}</p>
          <p class="text-sm leading-relaxed text-text-muted" set:html={t.remoteDevsBody} />
        </div>
        <div class="rounded-lg border border-border/50 bg-bg-surface/50 px-5 py-4">
          <p class="mb-1 text-xs font-medium text-accent">{t.remotePracticeLabel}</p>
          <p class="text-sm leading-relaxed text-text-muted" set:html={t.remotePracticeBody} />
        </div>
      </div>
    </div>
  </div>
</section>
