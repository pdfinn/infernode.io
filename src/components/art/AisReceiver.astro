---
// A USB AIS receiver with its VHF whip and a GPS puck: the kind that sends
// AIS and GPS sentences as one NMEA 0183 stream. Drawn in currentColor.
interface Props {
  x: number;
  y: number;
  width: number;
  class?: string;
}
const { x, y, width, class: cls = '' } = Astro.props;
const height = (width * 100) / 120;
---

<svg x={x} y={y} width={width} height={height} viewBox="0 0 120 100" class={cls} fill="none" xmlns="http://www.w3.org/2000/svg">
  <line x1="58" y1="4" x2="58" y2="50" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
  <rect x="54" y="40" width="8" height="12" rx="1.5" fill="currentColor" fill-opacity="0.5" />
  <path d="M50 14 q-6 7 0 14 M44 9 q-11 12 0 24 M66 14 q6 7 0 14 M72 9 q11 12 0 24" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" class="ais-waves" />
  <rect x="30" y="52" width="58" height="34" rx="5" class="fill-bg-surface" stroke="currentColor" stroke-width="1.6" />
  <text x="59" y="73" text-anchor="middle" fill="currentColor" font-size="11" font-weight="600" font-family="var(--font-family-mono)">AIS</text>
  <circle cx="38" cy="60" r="2" fill="currentColor"><animate attributeName="opacity" values="1;0.2;1" dur="1.3s" repeatCount="indefinite" /></circle>
  <circle cx="45" cy="60" r="2" fill="currentColor" fill-opacity="0.5" />
  <path d="M88 76 q14 0 16 10" stroke="currentColor" stroke-opacity="0.6" stroke-width="1.4" />
  <ellipse cx="106" cy="91" rx="12" ry="5" fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="1.2" />
  <path d="M96 90 q10 -10 20 0" stroke="currentColor" stroke-width="1.2" />
  <rect x="2" y="64" width="16" height="10" rx="2" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1" />
  <line x1="18" y1="69" x2="30" y2="69" stroke="currentColor" stroke-width="2" />
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ais-waves { animation: ais-pulse 2s ease-in-out infinite; }
  }
  @keyframes ais-pulse {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 1; }
  }
</style>
