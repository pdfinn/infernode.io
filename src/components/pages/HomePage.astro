---
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Hero from '../Hero.astro';
import DemoVideo from '../DemoVideo.astro';
import Security from '../Security.astro';
import HowItWorks from '../HowItWorks.astro';
import Alternatives from '../Alternatives.astro';
import Products from '../Products.astro';
import QuickStart from '../QuickStart.astro';
import Footer from '../Footer.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const meta = useTranslations(lang).meta.home;
---

<Base title={meta.title} description={meta.description} lang={lang}>
  <Nav lang={lang} />
  <main class="overflow-x-clip">
    <Hero lang={lang} />
    <DemoVideo lang={lang} />
    <Security lang={lang} />
    <HowItWorks lang={lang} />
    <Alternatives lang={lang} />
    <Products lang={lang} />
    <QuickStart lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
