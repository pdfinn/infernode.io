---
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import VisionGate from '../VisionGate.astro';
import NetworkDiagram from '../NetworkDiagram.astro';
import UseCases from '../UseCases.astro';
import Footer from '../Footer.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

// Setups on real devices, and the use cases they stand for.
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const meta = useTranslations(lang).meta.examples;
const t = useTranslations(lang).examplesPage;
const tabs = [
  { href: '#vision', icon: 'ph-video-camera', label: t.tabVision },
  { href: '#network', icon: 'ph-compass', label: t.tabNav },
  { href: '#use-cases', icon: 'ph-briefcase', label: t.tabUses },
];
---

<Base title={meta.title} description={meta.description} lang={lang} keywords={t.keywords}>
  <Nav lang={lang} />
  <main class="overflow-x-clip pt-32">
    <section class="px-6 text-center">
      <div class="mx-auto max-w-3xl">
        <p class="mb-6 text-sm font-medium tracking-widest uppercase text-accent">{t.eyebrow}</p>
        <h1 class="mb-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{t.title}</h1>
        <p class="mb-10 text-lg text-text-muted">{t.intro}</p>
        <nav class="flex flex-wrap justify-center gap-3" aria-label={t.eyebrow}>
          {tabs.map((tab) => (
            <a href={tab.href} class="inline-flex items-center gap-2 rounded-full border border-border bg-bg-surface px-4 py-2 text-sm text-text-muted transition hover:border-accent hover:text-text">
              <i class={`ph ${tab.icon} text-base text-accent`} aria-hidden="true"></i>{tab.label}
            </a>
          ))}
        </nav>
      </div>
    </section>
    <VisionGate lang={lang} />
    <div class="mx-auto h-px w-32 bg-border"></div>
    <NetworkDiagram lang={lang} />
    <UseCases lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
