---
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const meta = useTranslations(lang).meta.xenith;
const t = useTranslations(lang).xenithPage;
const shots = [
  { src: '/xenith/troff.webp', w: 1400, h: 900, caption: t.docsTroff, wide: true },
  { src: '/xenith/live-glenda.webp', w: 1600, h: 1000, caption: t.docsLive, wide: false },
  { src: '/xenith/agent-glenda.webp', w: 1600, h: 1000, caption: t.docsAgent, wide: false },
];
// Xenith's own selection colours: buttons 1, 2 and 3.
const hit = ['border-[#6c7086] bg-[#54566e]', 'border-[#ae6a71] bg-[#7c484d]', 'border-[#5a8a5d] bg-[#3b603d]'];
const releases = 'https://github.com/infernode-os/infernode/releases/latest';
const version = '0.9.0';
const dl = (f: string) => `https://github.com/infernode-os/infernode/releases/download/v${version}/xenith-${version}-${f}`;
const macDmg = dl('macos-arm64.dmg');
const plain = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&rsquo;/g, "'");
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Xenith',
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'Text editor',
    operatingSystem: 'macOS, Linux, Windows',
    description: meta.description,
    url: new URL(Astro.url.pathname, Astro.site).href,
    image: new URL('/xenith/og-xenith.png', Astro.site).href,
    downloadUrl: releases,
    softwareVersion: version,
    license: 'https://opensource.org/licenses/MIT',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: plain(f.a) },
    })),
  },
];
const eyebrow = 'mb-4 text-sm font-medium tracking-widest uppercase text-accent';
const h2 = 'text-3xl font-bold tracking-tight sm:text-4xl';
const code = '[&_code]:rounded [&_code]:bg-bg [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&_code]:text-text';
---

<Base title={meta.title} description={meta.description} lang={lang} keywords={t.keywords} ogImage="/xenith/og-xenith.png" jsonLd={jsonLd}>
  <Nav lang={lang} />
  <main class="theme-xenith overflow-x-clip px-6 pt-32 pb-24">

    <!-- Hero -->
    <section class="relative mx-auto max-w-4xl text-center">
      <div class="absolute inset-0 -top-24 mx-auto h-96 w-96 rounded-full bg-accent/10 blur-3xl"></div>
      <div class="relative">
        <img src="/xenith/xenith-logo.svg" alt="Xenith logo" width="128" height="128" class="mx-auto mb-6 h-28 w-28" />
        <p class="mb-6 text-sm font-medium tracking-widest uppercase text-accent">{t.eyebrow}</p>
        <h1 class="mb-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">{t.title}</h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg text-text-muted">{t.intro}</p>
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a href="#install" class="rounded-lg bg-accent px-8 py-3 font-medium text-white transition hover:bg-accent-glow">{t.ctaPrimary}</a>
          <a href="#mouse" class="rounded-lg border border-border px-8 py-3 font-medium text-text-muted transition hover:border-accent hover:text-text">{t.ctaSecondary}</a>
        </div>
      </div>
    </section>

    <!-- Video -->
    <section id="demo" class="mx-auto mt-24 max-w-5xl">
      <div class="mb-10 text-center">
        <p class={eyebrow}>{t.videoEyebrow}</p>
        <h2 class={`mb-4 ${h2}`}>{t.videoTitle}</h2>
        <p class="mx-auto max-w-2xl text-lg text-text-muted">{t.videoBody}</p>
      </div>
      <div class="overflow-hidden rounded-xl border border-border bg-black">
        <video
          id="xenith-video"
          class="block h-auto w-full"
          src="/xenith/xenith-demo.mp4"
          poster="/xenith/xenith-demo-poster.jpg"
          width="1600"
          height="1080"
          controls
          muted
          playsinline
          preload="metadata"
          aria-label={t.videoLabel}
        ></video>
      </div>
    </section>

    <!-- What it is -->
    <section class="mx-auto mt-32 max-w-5xl">
      <div class="mb-12 text-center">
        <p class={eyebrow}>{t.whatEyebrow}</p>
        <h2 class={h2}>{t.whatTitle}</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {t.what.map((c) => (
          <div class="min-w-0 rounded-xl border border-border bg-bg-surface p-6">
            <i class={`ph ${c.icon} mb-4 block text-3xl text-accent`} />
            <h3 class="mb-2 text-lg font-semibold">{c.title}</h3>
            <p class="text-sm leading-relaxed text-text-muted" set:html={c.body} />
          </div>
        ))}
      </div>
    </section>

    <!-- Why it is different -->
    <section class="mx-auto mt-32 max-w-5xl">
      <div class="mb-12 text-center">
        <p class={eyebrow}>{t.whyEyebrow}</p>
        <h2 class={h2}>{t.whyTitle}</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {t.why.map((c) => (
          <div class="min-w-0 rounded-xl border border-border bg-bg-surface p-6">
            <i class={`ph ${c.icon} mb-4 block text-2xl text-node-jetson`} />
            <h3 class="mb-2 text-lg font-semibold">{c.title}</h3>
            <p class={`text-sm leading-relaxed text-text-muted ${code}`} set:html={c.body} />
          </div>
        ))}
      </div>
    </section>

    <!-- Veltro -->
    <section class="mx-auto mt-32 max-w-5xl">
      <div class="mb-10 text-center">
        <p class={eyebrow}>{t.veltroEyebrow}</p>
        <h2 class={`mb-4 ${h2}`}>{t.veltroTitle}</h2>
        <p class={`mx-auto max-w-2xl text-lg text-text-muted ${code}`} set:html={t.veltroIntro} />
      </div>
      <figure>
        <a href="/xenith/veltro.webp" class="block overflow-hidden rounded-xl border border-border transition hover:border-accent">
          <img src="/xenith/veltro.webp" alt={t.veltroAlt} width="1400" height="875" loading="lazy" class="block h-auto w-full" />
        </a>
        <figcaption class={`mt-3 text-sm text-text-muted ${code}`} set:html={t.veltroCaption} />
      </figure>
    </section>

    <!-- Beyond code -->
    <section class="mx-auto mt-32 max-w-5xl">
      <div class="mb-12 text-center">
        <p class={eyebrow}>{t.beyondEyebrow}</p>
        <h2 class={`mb-4 ${h2}`}>{t.beyondTitle}</h2>
        <p class="mx-auto max-w-2xl text-lg text-text-muted">{t.beyondIntro}</p>
      </div>
      <div class="space-y-12">
        {t.beyond.map((b) => (
          <div class="grid items-center gap-8 md:grid-cols-2">
            <a href={b.img} class="block min-w-0 overflow-hidden rounded-xl border border-border transition hover:border-accent">
              <img src={b.img} alt={plain(b.alt)} width={b.w} height={b.h} loading="lazy" class="block h-auto w-full" />
            </a>
            <div class="min-w-0">
              <h3 class="mb-3 text-2xl font-semibold">{b.title}</h3>
              <p class={`leading-relaxed text-text-muted ${code}`} set:html={b.body} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Documents -->
    <section class="mx-auto mt-32 max-w-5xl">
      <div class="mb-12 text-center">
        <p class={eyebrow}>{t.docsEyebrow}</p>
        <h2 class={h2}>{t.docsTitle}</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {shots.map((s) => (
          <figure class={`min-w-0 ${s.wide ? 'md:col-span-2' : ''}`}>
            <a href={s.src} class="block overflow-hidden rounded-xl border border-border transition hover:border-accent">
              <img src={s.src} alt="" width={s.w} height={s.h} loading="lazy" class="block h-auto w-full" />
            </a>
            <figcaption class="mt-3 text-sm text-text-muted" set:html={s.caption} />
          </figure>
        ))}
      </div>
    </section>

    <!-- Mouse -->
    <section id="mouse" class="mx-auto mt-32 max-w-5xl scroll-mt-24">
      <div class="mb-12 text-center">
        <p class={eyebrow}>{t.mouseEyebrow}</p>
        <h2 class={`mb-4 ${h2}`}>{t.mouseTitle}</h2>
        <p class="mx-auto max-w-2xl text-lg text-text-muted">{t.mouseIntro}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {t.buttons.map((b, i) => (
          <div class="min-w-0 rounded-xl border border-border bg-bg-surface p-6">
            <div class="mb-4 flex gap-1.5" aria-hidden="true">
              {[0, 1, 2].map((n) => (
                <span class={`h-8 w-7 rounded-md border ${n === i ? hit[i] : 'border-border bg-bg'}`}></span>
              ))}
            </div>
            <p class="text-sm text-text-muted">{b.name}</p>
            <h3 class="mb-2 text-xl font-semibold">{b.verb}</h3>
            <p class={`text-sm leading-relaxed text-text-muted ${code}`} set:html={b.body} />
          </div>
        ))}
      </div>
      <div class="mt-6 rounded-xl border border-accent/40 bg-bg-surface p-6">
        <div class="mb-3 flex items-center gap-3">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-8 w-7 rounded-md border border-[#6c7086] bg-[#54566e]"></span>
            <span class="h-8 w-7 rounded-md border border-[#ae6a71] bg-[#7c484d]"></span>
            <span class="h-8 w-7 rounded-md border border-border bg-bg"></span>
          </div>
          <h3 class="text-lg font-semibold">{t.argTitle}</h3>
        </div>
        <p class={`text-sm leading-relaxed text-text-muted ${code}`} set:html={t.argBody} />
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="min-w-0 rounded-xl border border-border bg-bg-surface p-6">
          <h3 class="mb-1 text-lg font-semibold">{t.chordsTitle}</h3>
          <p class="mb-4 text-sm text-text-muted">{t.chordsIntro}</p>
          <dl class="space-y-2 text-sm">
            {t.chords.map((c) => (
              <div class="flex justify-between gap-4 border-t border-border pt-2">
                <dt class="font-medium text-text">{c.keys}</dt>
                <dd class="text-right text-text-muted">{c.does}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="min-w-0 rounded-xl border border-border bg-bg-surface p-6">
          <h3 class="mb-4 text-lg font-semibold">{t.commandsTitle}</h3>
          <dl class="grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
            {t.commands.map(([word, does]) => (
              <div class={`min-w-0 ${word === 'Edit' ? 'sm:col-span-2' : ''}`}>
                <dt class="inline font-mono text-text">{word}</dt>
                <dd class={`inline text-text-muted ${code}`} set:html={` &mdash; ${does}`} />
              </div>
            ))}
          </dl>
        </div>
      </div>
      <p class={`mt-6 text-center text-sm text-text-muted ${code}`} set:html={t.trackpad} />

      <div class="mt-10">
        <h3 class="mb-3 text-center text-lg font-semibold">{t.furtherTitle}</h3>
        <ul class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm">
          {t.further.map((l) => (
            <li>
              <a href={l.href} class="text-accent hover:underline" target="_blank" rel="noopener">{l.label}</a>
              <span class="text-text-muted" set:html={` &mdash; ${l.note}`} />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto mt-32 max-w-3xl">
      <div class="mb-10 text-center">
        <p class={eyebrow}>{t.faqEyebrow}</p>
        <h2 class={h2}>{t.faqTitle}</h2>
      </div>
      <div class="space-y-6">
        {t.faq.map((f) => (
          <div>
            <h3 class="mb-1 font-semibold">{f.q}</h3>
            <p class={`text-sm leading-relaxed text-text-muted ${code}`} set:html={f.a} />
          </div>
        ))}
      </div>
    </section>

    <!-- Install -->
    <section id="install" class="mx-auto mt-32 max-w-5xl scroll-mt-24 text-center">
      <img src="/xenith/xenith-icon.webp" alt="" width="256" height="256" class="mx-auto mb-4 h-24 w-24" />
      <p class={eyebrow}>{t.installEyebrow}</p>
      <h2 class={`mb-10 ${h2}`}>{t.installTitle}</h2>
      <div class="grid gap-6 text-left md:grid-cols-3">
        <div class="min-w-0 rounded-xl border border-border bg-bg-surface p-6">
          <h3 class="mb-4 flex items-center gap-2 font-semibold"><i class="ph ph-linux-logo text-xl" />Linux</h3>
          <div class="mb-3 flex flex-wrap gap-2">
            <a href={dl('linux-amd64.tar.gz')} class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition hover:bg-accent-glow"><i class="ph ph-download-simple" />{t.installLinuxIntel}</a>
            <a href={dl('linux-arm64.tar.gz')} class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-medium text-text transition hover:border-accent"><i class="ph ph-download-simple" />{t.installLinuxArm}</a>
          </div>
          <p class={`text-sm leading-relaxed text-text-muted ${code}`} set:html={t.installLinuxNote} />
        </div>
        <div class="min-w-0 rounded-xl border border-border bg-bg-surface p-6">
          <h3 class="mb-4 flex items-center gap-2 font-semibold"><i class="ph ph-apple-logo text-xl" />macOS</h3>
          <a href={macDmg} class="mb-3 inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition hover:bg-accent-glow"><i class="ph ph-download-simple" />{t.installMacButton}</a>
          <p class="mb-2 text-sm text-text-muted">{t.installMacNote}</p>
          <pre class="whitespace-pre-wrap break-words rounded-lg border border-border bg-bg px-3 py-2 font-mono text-xs text-text"><code>brew install --cask infernode-os/tap/xenith</code></pre>
        </div>
        <div class="min-w-0 rounded-xl border border-border bg-bg-surface p-6">
          <h3 class="mb-4 flex items-center gap-2 font-semibold"><i class="ph ph-windows-logo text-xl" />Windows</h3>
          <a href={dl('windows-amd64.zip')} class="mb-3 inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition hover:bg-accent-glow"><i class="ph ph-download-simple" />{t.installWinButton}</a>
          <p class={`text-sm leading-relaxed text-text-muted ${code}`} set:html={t.installWinNote} />
        </div>
      </div>
      <p class="mt-6 text-sm text-text-muted" set:html={t.installAgent} />
      <a href={releases} class="mt-8 inline-block rounded-lg bg-accent px-8 py-3 font-medium text-white transition hover:bg-accent-glow">{t.installCta}</a>
      <p class="mx-auto mt-16 max-w-xl text-sm text-text-muted" set:html={t.credit} />
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<script>
  // Start the recording, muted, the first time it scrolls into view.
  const video = document.getElementById('xenith-video') as HTMLVideoElement | null;
  if (video && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        video.play().catch(() => {});
        io.disconnect();
      }
    }, { threshold: 0.5 });
    io.observe(video);
  }
</script>
