---
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Vision from '../Vision.astro';
import Pillars from '../Pillars.astro';
import Screenshot from '../Screenshot.astro';
import DistributedArch from '../DistributedArch.astro';
import Contributing from '../Contributing.astro';
import WhyNow from '../WhyNow.astro';
import Footer from '../Footer.astro';
import { useTranslations, p, type Lang } from '../../i18n/utils';

// The sections that used to make the homepage 14 screens long.
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const meta = useTranslations(lang).meta.platform;
const t = useTranslations(lang).platformPage;
const ex = useTranslations(lang).platformExamples;
---

<Base title={meta.title} description={meta.description} lang={lang}>
  <Nav lang={lang} />
  <main class="overflow-x-clip pt-32">
    <section class="px-6 text-center">
      <div class="mx-auto max-w-3xl">
        <p class="mb-6 text-sm font-medium tracking-widest uppercase text-accent">{t.eyebrow}</p>
        <h1 class="mb-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{t.title}</h1>
        <p class="text-lg text-text-muted">{t.intro}</p>
      </div>
    </section>
    <Vision lang={lang} />
    <Pillars lang={lang} />
    <Screenshot lang={lang} />
    <section class="px-6 py-16">
      <a href={p('/examples', lang)} class="group mx-auto flex max-w-3xl flex-col items-start gap-4 rounded-2xl border border-border bg-bg-surface p-8 transition hover:border-accent sm:flex-row sm:items-center">
        <i class="ph ph-video-camera text-4xl text-accent" aria-hidden="true"></i>
        <div class="flex-1">
          <h2 class="mb-1 text-xl font-semibold">{ex.title}</h2>
          <p class="text-sm leading-relaxed text-text-muted" set:html={ex.body} />
        </div>
        <span class="text-sm font-medium text-accent group-hover:underline" set:html={ex.cta} />
      </a>
    </section>
    <DistributedArch lang={lang} />
    <Contributing lang={lang} />
    <WhyNow lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
